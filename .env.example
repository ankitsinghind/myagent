# SentinelSOC Configuration Template
# Copy this file to '.env' and fill in your details.

# 1. Google Gemini API Configuration (Obtained from Google AI Studio)
# Leave blank to run the dashboard in "Mock/Demo Mode" (ideal for offline tests).
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Local Server Port and Host
HOST=127.0.0.1
PORT=8000
