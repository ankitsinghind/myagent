# SentinelSOC Configuration Template
# Copy this file to '.env' and fill in your details.

# 1. Google Gemini API Configuration (Obtained from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

HOST=127.0.0.1
PORT=8000

# 2. IMAP Email Ingestion Configuration (OPTIONAL)

IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX

# Update with your credentials if you want to setup for automatic fetching from your email.
IMAP_EMAIL=your_email@gmail.com
IMAP_PASSWORD=your_app_password_here